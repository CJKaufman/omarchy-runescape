#!/usr/bin/env python3
"""
RuneScape Quick-Screen & Notification Manager Helper
Manages RuneLite Hyprland scratchpad overlay, Jagex Launcher processes,
focus-loss auto-dismiss, and idle/AFK notification flasher.
"""

import os
import sys
import json
import time
import stat
import socket
import select
import subprocess
import fcntl
from pathlib import Path

MAX_STDIN_BYTES = 65536
MAX_FILE_BYTES = 65536
MAX_SOCKET_BUFFER = 65536
MAX_SUBPROCESS_BYTES = 262144
MAX_NOTIF_FILES_SCANNED = 50

HYPRCTL_BIN = "/usr/bin/hyprctl"
PGREP_BIN = "/usr/bin/pgrep"
PKILL_BIN = "/usr/bin/pkill"
NOTIFY_SEND_BIN = "/usr/bin/notify-send"
PYTHON_BIN = "/usr/bin/python3"

STATE_DIR = Path.home() / ".local/state/omarchy/cjkaufman.runescape"
STATE_FILE = STATE_DIR / "state.json"
PID_FILE = Path(f"/run/user/{os.getuid()}/runescape-helper.pid")
LOCK_FILE = Path(f"/run/user/{os.getuid()}/runescape-helper.lock")
NOTIF_DIR = Path.home() / ".local/state/omarchy/notifications"
SHELL_CONFIG_FILE = Path.home() / ".config/omarchy/shell.json"

DAEMON_LOCK_FD = None

POPUP_W = 840
POPUP_H = 600
POPUP_X = 680
POPUP_Y = 34

def is_trusted_executable(file_path):
    """
    Validates that a path:
    1. Is not empty and exists.
    2. Does not traverse untrusted symlinks.
    3. Is owned by root (uid 0) or the current user (uid os.getuid()).
    4. Is not world-writable (mode & 0o002 == 0).
    5. Is a regular file.
    6. Is executable.
    """
    if not file_path:
        return False
    try:
        raw_path = os.path.abspath(str(file_path))
        st_raw = os.lstat(raw_path)

        parent_dir = os.path.dirname(raw_path)
        if os.path.exists(parent_dir):
            st_parent = os.stat(parent_dir)
            if st_parent.st_mode & 0o002 != 0:
                return False

        if stat.S_ISLNK(st_raw.st_mode):
            if st_raw.st_uid not in (0, os.getuid()):
                return False
            real_path = os.path.realpath(raw_path)
            st_real = os.stat(real_path)
            if not stat.S_ISREG(st_real.st_mode):
                return False
            if st_real.st_uid not in (0, os.getuid()):
                return False
            if st_real.st_mode & 0o002 != 0:
                return False
            if not os.access(real_path, os.X_OK):
                return False
            return True
        else:
            if not stat.S_ISREG(st_raw.st_mode):
                return False
            if st_raw.st_uid not in (0, os.getuid()):
                return False
            if st_raw.st_mode & 0o002 != 0:
                return False
            if not os.access(raw_path, os.X_OK):
                return False
            return True
    except Exception:
        return False

def get_trusted_tool(name, default_path):
    candidates = [default_path, f"/bin/{name}", f"/usr/local/bin/{name}"]
    for cand in candidates:
        if is_trusted_executable(cand):
            return cand
    return None

def get_hyprctl():
    return get_trusted_tool("hyprctl", HYPRCTL_BIN)

def get_pgrep():
    return get_trusted_tool("pgrep", PGREP_BIN)

def get_pkill():
    return get_trusted_tool("pkill", PKILL_BIN)

def get_notify_send():
    return get_trusted_tool("notify-send", NOTIFY_SEND_BIN)

def run_cmd_bounded(cmd, timeout=3.0, max_bytes=MAX_SUBPROCESS_BYTES):
    """
    Executes command with strict timeout and output ceiling.
    Kills and reaps child process if limits are exceeded.
    """
    proc = None
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            close_fds=True
        )
        out_chunks = []
        bytes_read = 0
        deadline = time.time() + timeout

        os.set_blocking(proc.stdout.fileno(), False)

        while time.time() < deadline:
            ret = proc.poll()
            r, _, _ = select.select([proc.stdout], [], [], 0.2)
            if r:
                chunk = proc.stdout.read(4096)
                if not chunk:
                    break
                out_chunks.append(chunk)
                bytes_read += len(chunk)
                if bytes_read >= max_bytes:
                    proc.kill()
                    proc.wait()
                    break
            elif ret is not None:
                break
        else:
            proc.kill()
            proc.wait()
            return ""

        if proc.poll() is None:
            proc.kill()
            proc.wait()

        return b"".join(out_chunks)[:max_bytes].decode("utf-8", errors="ignore").strip()
    except Exception:
        if proc:
            try:
                proc.kill()
                proc.wait()
            except Exception:
                pass
        return ""

def run_hyprctl(args):
    bin_path = get_hyprctl()
    if not bin_path:
        return ""
    return run_cmd_bounded([bin_path] + args, timeout=3.0)

def run_hypr_eval(lua_code):
    bin_path = get_hyprctl()
    if not bin_path:
        return ""
    return run_cmd_bounded([bin_path, "repl", lua_code], timeout=3.0)

def run_hypr_dispatch(lua_dsp):
    bin_path = get_hyprctl()
    if not bin_path:
        return ""
    return run_cmd_bounded([bin_path, "dispatch", lua_dsp], timeout=3.0)

def send_desktop_notification(summary, body, urgency="normal"):
    bin_path = get_notify_send()
    if not bin_path:
        return
    proc = None
    try:
        proc = subprocess.Popen(
            [bin_path, "-u", urgency, "-a", "RuneScape", str(summary)[:128], str(body)[:256]],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True
        )
        proc.wait(timeout=2.0)
    except Exception:
        if proc:
            try:
                proc.kill()
                proc.wait()
            except Exception:
                pass

def get_runelite_client():
    out = run_hyprctl(["clients", "-j"])
    if not out:
        return None
    try:
        clients = json.loads(out)
        for c in clients:
            cls = c.get("class", "").lower()
            if "runelite" in cls or cls == "net-runelite-launcher-launcher":
                return c
    except Exception:
        pass
    return None

def is_runelite_in_scratchpad(client=None):
    if not client:
        client = get_runelite_client()
    if not client:
        return False
    ws_name = client.get("workspace", {}).get("name", "")
    return "special:runescape" in ws_name

def is_jagex_launcher_running():
    bin_path = get_pgrep()
    if not bin_path:
        return False
    proc = None
    try:
        proc = subprocess.Popen(
            [bin_path, "-f", "jagex-launcher"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True
        )
        proc.wait(timeout=2.0)
        return proc.returncode == 0
    except Exception:
        if proc:
            try:
                proc.kill()
                proc.wait()
            except Exception:
                pass
        return False

def get_active_special_workspace():
    try:
        out = run_hyprctl(["monitors", "-j"])
        if not out:
            return ""
        mons = json.loads(out)
        for m in mons:
            if m.get("focused"):
                return m.get("specialWorkspace", {}).get("name", "")
        if mons:
            return mons[0].get("specialWorkspace", {}).get("name", "")
    except Exception:
        pass
    return ""

def get_monitor_geometry():
    try:
        out = run_hyprctl(["monitors", "-j"])
        if out:
            mons = json.loads(out)
            for m in mons:
                if m.get("focused"):
                    scale = float(m.get("scale", 1.0))
                    w = int(m.get("width", 1920) / scale)
                    h = int(m.get("height", 1080) / scale)
                    return w, h
            if mons:
                m = mons[0]
                scale = float(m.get("scale", 1.0))
                w = int(m.get("width", 1920) / scale)
                h = int(m.get("height", 1080) / scale)
                return w, h
    except Exception:
        pass
    return 1280, 720

def rescue_trapped_windows():
    """
    Safety invariant: scans special:runescape. If any non-RuneLite window
    (such as zen browser or foot) is on special:runescape, moves it back
    to workspace 1 immediately.
    """
    lua = """
    for _, w in ipairs(hl.get_windows()) do
      if w.workspace and w.workspace.name == "special:runescape" then
        local cls = (w.class or ""):lower()
        if not (cls:find("runelite") or cls:find("net-runelite")) then
          hl.dispatch(hl.dsp.focus({ window = w }))
          local act = hl.get_active_window()
          if act and act.address == w.address then
            hl.dispatch(hl.dsp.window.move({ workspace = "1", follow = false }))
          end
        end
      end
    end
    """
    run_hypr_eval(lua)

def refocus_active_workspace():
    """
    Shifts focus to any window on the currently active normal workspace.
    Guarantees RuneLite is never left as the top-of-stack focused window
    when the special:runescape workspace is hidden or dismissed.
    """
    lua = """
    local active_ws = hl.get_active_workspace()
    if not active_ws then return end
    for _, w in ipairs(hl.get_windows()) do
      if w.workspace and w.workspace.id == active_ws.id and w.mapped and not w.hidden then
        hl.dispatch(hl.dsp.focus({ window = "address:" .. w.address }))
        return
      end
    end
    hl.dispatch(hl.dsp.focus({ workspace = active_ws.name }))
    """
    run_hypr_eval(lua)

def ensure_runelite_geometry(w=POPUP_W, h=POPUP_H):
    """
    Positions and resizes RuneLite directly under the top bar.
    STRICT SAFETY: Only moves the window if focus was verified to match
    the RuneLite address AND RuneLite is in special:runescape. Never touches
    any other application window or normal tiled game client.
    """
    client = get_runelite_client()
    if not client:
        return
    if not is_runelite_in_scratchpad(client):
        return
    addr = str(client.get("address", "")).replace('"', '').strip()
    if not addr:
        return

    mon_w, _ = get_monitor_geometry()
    pos_x = max(0, mon_w - w - 16)
    pos_y = POPUP_Y

    lua = f"""
    local target_addr = "{addr}"
    for _, win in ipairs(hl.get_windows()) do
      if win.address == target_addr then
        hl.dispatch(hl.dsp.focus({{ window = win }}))
        local act = hl.get_active_window()
        if act and act.address == target_addr then
          if act.fullscreen and act.fullscreen ~= 0 then
            hl.dispatch(hl.dsp.window.fullscreen({{ mode = "fullscreen" }}))
          end
          if not act.floating then
            hl.dispatch(hl.dsp.window.float({{ action = "toggle" }}))
          end
          hl.dispatch(hl.dsp.window.move({{ x = {pos_x}, y = {pos_y}, relative = false }}))
          hl.dispatch(hl.dsp.window.resize({{ x = {w}, y = {h}, relative = false }}))
        end
        break
      end
    end
    """
    run_hypr_eval(lua)

def ensure_jagex_launcher_hidden():
    """
    If RuneLite is running, ensure jagex-launcher scratchpad
    is closed/tucked away in 'special:runescape_launcher'.
    """
    active_sw = get_active_special_workspace()
    if active_sw == "special:runescape_launcher":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape_launcher")')

def ensure_state_dir():
    current = Path.home()
    for part in [".local", "state", "omarchy", "cjkaufman.runescape"]:
        current = current / part
        c_str = str(current)
        if os.path.islink(c_str):
            os.unlink(c_str)
        if not os.path.exists(c_str):
            os.mkdir(c_str, 0o700)
        st = os.lstat(c_str)
        if stat.S_ISLNK(st.st_mode):
            raise PermissionError(f"Symlink detected at {c_str}")
        if st.st_uid != os.getuid():
            raise PermissionError(f"Directory not owned by current user: {c_str}")
        if current == STATE_DIR:
            os.chmod(c_str, 0o700)

def safe_write_state(state):
    ensure_state_dir()
    payload = json.dumps(state, indent=2).encode("utf-8")
    if len(payload) > MAX_FILE_BYTES:
        raise ValueError("State payload exceeds maximum byte limit")
    tmp_path = str(STATE_DIR / f".state.tmp.{os.getpid()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(tmp_path, flags, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, str(STATE_FILE))
    except Exception as e:
        if os.path.exists(tmp_path):
            try:
                os.unlink(tmp_path)
            except Exception:
                pass
        print(f"Failed to write state: {e}", file=sys.stderr)

def read_daemon_pid():
    pid_str = str(PID_FILE)
    if not os.path.exists(pid_str):
        return None
    try:
        st = os.lstat(pid_str)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
            remove_daemon_pid()
            return None
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(pid_str, flags)
        with os.fdopen(fd, "r", encoding="utf-8") as f:
            raw = f.read(32).strip()
        if raw.isdigit():
            return int(raw)
    except Exception:
        pass
    return None

def write_daemon_pid():
    pid_str = str(PID_FILE)
    if os.path.lexists(pid_str):
        remove_daemon_pid()
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    fd = os.open(pid_str, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(str(os.getpid()))
        f.flush()
        os.fsync(f.fileno())

def remove_daemon_pid():
    pid_str = str(PID_FILE)
    try:
        if os.path.lexists(pid_str):
            st = os.lstat(pid_str)
            if not stat.S_ISLNK(st.st_mode) and st.st_uid == os.getuid():
                os.unlink(pid_str)
            elif stat.S_ISLNK(st.st_mode):
                os.unlink(pid_str)
    except Exception:
        pass

def acquire_daemon_lock():
    global DAEMON_LOCK_FD
    lock_str = str(LOCK_FILE)
    try:
        flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(lock_str, flags, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        DAEMON_LOCK_FD = fd
        return True
    except (BlockingIOError, OSError):
        return False

def remove_daemon_lock():
    global DAEMON_LOCK_FD
    if DAEMON_LOCK_FD is not None:
        try:
            fcntl.flock(DAEMON_LOCK_FD, fcntl.LOCK_UN)
            os.close(DAEMON_LOCK_FD)
        except Exception:
            pass
        DAEMON_LOCK_FD = None
    lock_str = str(LOCK_FILE)
    try:
        if os.path.lexists(lock_str):
            st = os.lstat(lock_str)
            if not stat.S_ISLNK(st.st_mode) and st.st_uid == os.getuid():
                os.unlink(lock_str)
    except Exception:
        pass

def get_custom_binary_setting(key):
    try:
        cfg_str = str(SHELL_CONFIG_FILE)
        if not os.path.exists(cfg_str):
            return None
        st = os.lstat(cfg_str)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
            return None
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(cfg_str, flags)
        with os.fdopen(fd, "r", encoding="utf-8") as f:
            raw = f.read(MAX_FILE_BYTES)
        data = json.loads(raw)
        sections = data.get("bar", {}).get("layout", {})
        for sec in ["left", "center", "right"]:
            for item in sections.get(sec, []):
                if isinstance(item, dict) and item.get("id") == "cjkaufman.runescape":
                    val = item.get(key)
                    if isinstance(val, str) and val.strip():
                        return val.strip()
    except Exception:
        pass
    return None

def find_jagex_launcher():
    custom = get_custom_binary_setting("customLauncherPath")
    if custom and is_trusted_executable(custom):
        return custom

    candidates = [
        "/usr/bin/jagex-launcher",
        "/usr/local/bin/jagex-launcher",
        str(Path.home() / ".local/bin/jagex-launcher"),
        str(Path.home() / ".local/bin/jagex-launcher.AppImage"),
        str(Path.home() / ".local/bin/jagex-launcher-beta-linux-x86_64.AppImage"),
        str(Path.home() / ".local/share/Jagex Launcher/jagex-launcher"),
        str(Path.home() / ".local/share/Jagex Launcher/jagex-launcher.AppImage"),
        "/var/lib/flatpak/exports/bin/com.jagex.Launcher",
        str(Path.home() / ".local/share/flatpak/exports/bin/com.jagex.Launcher"),
    ]
    for c in candidates:
        if is_trusted_executable(c):
            return c
    return None

def find_runelite():
    custom = get_custom_binary_setting("customRuneLitePath")
    if custom and is_trusted_executable(custom):
        return custom

    candidates = [
        "/usr/bin/runelite",
        "/usr/bin/RuneLite",
        "/usr/local/bin/runelite",
        "/usr/local/bin/RuneLite",
        "/var/lib/flatpak/exports/bin/net.runelite.RuneLite",
        str(Path.home() / ".local/share/flatpak/exports/bin/net.runelite.RuneLite"),
        str(Path.home() / ".local/bin/runelite"),
        str(Path.home() / ".local/bin/RuneLite"),
        str(Path.home() / ".local/bin/RuneLite.AppImage"),
        str(Path.home() / ".local/share/runelite/RuneLite.AppImage"),
        str(Path.home() / ".local/share/Jagex Launcher/games/runelite/RuneLite.AppImage"),
    ]
    for c in candidates:
        if is_trusted_executable(c):
            return c
    return None

def read_shell_json_setting():
    cfg_str = str(SHELL_CONFIG_FILE)
    if not os.path.exists(cfg_str):
        return True
    try:
        st = os.lstat(cfg_str)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
            return True
        if st.st_size > MAX_FILE_BYTES:
            return True
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(cfg_str, flags)
        with os.fdopen(fd, "r", encoding="utf-8") as f:
            raw = f.read(MAX_FILE_BYTES)
        data = json.loads(raw)
        sections = data.get("bar", {}).get("layout", {})
        for sec in ["left", "center", "right"]:
            for item in sections.get(sec, []):
                if isinstance(item, dict) and item.get("id") == "cjkaufman.runescape":
                    if "showCharacterName" in item:
                        return bool(item["showCharacterName"])
    except Exception:
        pass
    return True

def update_shell_json_setting(show_character_name):
    cfg_str = str(SHELL_CONFIG_FILE)
    if not os.path.exists(cfg_str):
        return
    try:
        st = os.lstat(cfg_str)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
            return
        if st.st_size > MAX_FILE_BYTES:
            return
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(cfg_str, flags)
        with os.fdopen(fd, "r", encoding="utf-8") as f:
            raw = f.read(MAX_FILE_BYTES)
        data = json.loads(raw)
        modified = False
        sections = data.get("bar", {}).get("layout", {})
        for sec in ["left", "center", "right"]:
            for item in sections.get(sec, []):
                if isinstance(item, dict) and item.get("id") == "cjkaufman.runescape":
                    if item.get("showCharacterName") != show_character_name:
                        item["showCharacterName"] = show_character_name
                        modified = True
        if modified:
            parent_dir = os.path.dirname(cfg_str)
            tmp_path = os.path.join(parent_dir, f".shell.json.tmp.{os.getpid()}")
            w_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
            payload = json.dumps(data, indent=2).encode("utf-8")
            w_fd = os.open(tmp_path, w_flags, 0o600)
            with os.fdopen(w_fd, "wb") as w_f:
                w_f.write(payload)
                w_f.flush()
                os.fsync(w_f.fileno())
            os.replace(tmp_path, cfg_str)
    except Exception as e:
        print(f"Error updating shell.json: {e}", file=sys.stderr)

def safe_read_state():
    default_show_name = read_shell_json_setting()
    default_state = {
        "running": False,
        "launcherRunning": False,
        "character": "",
        "popupOpen": False,
        "mode": "popup",
        "alert": False,
        "alertMessage": "",
        "address": "",
        "showCharacterName": default_show_name,
        "lastDismissTime": 0,
        "lastNotifTime": 0,
        "lastUpdated": int(time.time() * 1000)
    }
    state_str = str(STATE_FILE)
    if not os.path.exists(state_str):
        return default_state
    try:
        st = os.lstat(state_str)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
            return default_state
        if st.st_size > MAX_FILE_BYTES:
            return default_state
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(state_str, flags)
        with os.fdopen(fd, "r", encoding="utf-8") as f:
            raw = f.read(MAX_FILE_BYTES)
        st_data = json.loads(raw)
        if isinstance(st_data, dict):
            if "showCharacterName" not in st_data:
                st_data["showCharacterName"] = default_show_name
            return st_data
    except Exception:
        pass
    return default_state

def action_status():
    ensure_daemon_running()
    rescue_trapped_windows()
    client = get_runelite_client()
    state = safe_read_state()
    jagex_running = is_jagex_launcher_running()

    if client:
        ensure_jagex_launcher_hidden()
        title = client.get("title", "")
        char_name = ""
        if " - " in title:
            char_name = title.split(" - ", 1)[1].strip()
        state["running"] = True
        state["character"] = char_name or state.get("character", "DarkOmenZA")
        state["address"] = client.get("address", "")
        if is_runelite_in_scratchpad(client):
            state["mode"] = "popup"
        else:
            state["mode"] = "normal"
            state["popupOpen"] = False
    else:
        state["running"] = False
        state["popupOpen"] = False

    state["launcherRunning"] = jagex_running
    state["lastUpdated"] = int(time.time() * 1000)
    safe_write_state(state)
    return state

def action_toggle():
    rescue_trapped_windows()
    client = get_runelite_client()
    state = safe_read_state()
    if not client:
        return {"ok": False, "error": "RuneLite is not running", "running": False}

    in_scratchpad = is_runelite_in_scratchpad(client)
    now = time.time()

    if not in_scratchpad:
        addr = str(client.get("address", "")).replace('"', '').strip()
        if addr:
            lua = f"""
            local target_addr = "{addr}"
            for _, w in ipairs(hl.get_windows()) do
              if w.address == target_addr then
                hl.dispatch(hl.dsp.focus({{ window = w }}))
                break
              end
            end
            """
            run_hypr_eval(lua)
        state["popupOpen"] = False
        state["mode"] = "normal"
        state["alert"] = False
        state["alertMessage"] = ""
        state["lastUpdated"] = int(now * 1000)
        safe_write_state(state)
        return {"ok": True, "mode": "normal", "focused": True, "popupOpen": False}

    active_sw = get_active_special_workspace()
    is_open = (active_sw == "special:runescape")
    last_dismiss = float(state.get("lastDismissTime", 0))

    if not is_open and (now - last_dismiss) < 0.4:
        state["popupOpen"] = False
        state["lastUpdated"] = int(now * 1000)
        safe_write_state(state)
        return {"ok": True, "popupOpen": False}

    if active_sw == "special:runescape_launcher":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape_launcher")')

    target_open = not is_open
    state["popupOpen"] = target_open
    state["running"] = True
    state["lastUpdated"] = int(now * 1000)

    if target_open:
        state["alert"] = False
        state["alertMessage"] = ""
        state["openedAt"] = now
        state["hasGainedFocus"] = False
        safe_write_state(state)
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
        ensure_runelite_geometry()
        addr = str(client.get("address", "")).replace('"', '').strip()
        if addr:
            lua = f"""
            local target_addr = "{addr}"
            for _, w in ipairs(hl.get_windows()) do
              if w.address == target_addr then
                hl.dispatch(hl.dsp.focus({{ window = w }}))
                break
              end
            end
            """
            run_hypr_eval(lua)
    else:
        state["lastDismissTime"] = now
        safe_write_state(state)
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
        refocus_active_workspace()

    return {"ok": True, "popupOpen": state["popupOpen"]}

def action_dismiss():
    state = safe_read_state()
    active_sw = get_active_special_workspace()
    now = time.time()
    state["popupOpen"] = False
    state["hasGainedFocus"] = False
    state["lastDismissTime"] = now
    state["lastUpdated"] = int(now * 1000)
    safe_write_state(state)
    client = get_runelite_client()
    if is_runelite_in_scratchpad(client):
        if active_sw == "special:runescape":
            run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
        refocus_active_workspace()
    return {"ok": True, "popupOpen": False}

def action_detach(ws="5"):
    client = get_runelite_client()
    if not client:
        return {"ok": False, "error": "RuneLite is not running"}
    addr = str(client.get("address", "")).replace('"', '').strip()
    if not addr:
        return {"ok": False, "error": "No RuneLite address"}

    lua_detach = f"""
    local target_addr = "{addr}"
    for _, w in ipairs(hl.get_windows()) do
      if w.address == target_addr then
        hl.dispatch(hl.dsp.focus({{ window = w }}))
        local act = hl.get_active_window()
        if act and act.address == target_addr then
          if act.floating then
            hl.dispatch(hl.dsp.window.float({{ action = "toggle" }}))
          end
          hl.dispatch(hl.dsp.window.move({{ workspace = "{ws}", follow = true }}))
          hl.dispatch(hl.dsp.window.center({{}}))
        end
        break
      end
    end
    """
    run_hypr_eval(lua_detach)
    active_sw = get_active_special_workspace()
    if active_sw == "special:runescape":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
    state = safe_read_state()
    state["popupOpen"] = False
    state["mode"] = "normal"
    safe_write_state(state)
    return {"ok": True, "mode": "normal", "workspace": ws}

def action_dock():
    client = get_runelite_client()
    if not client:
        return {"ok": False, "error": "RuneLite is not running"}
    addr = str(client.get("address", "")).replace('"', '').strip()
    if not addr:
        return {"ok": False, "error": "No RuneLite address"}

    mon_w, _ = get_monitor_geometry()
    pos_x = max(0, mon_w - POPUP_W - 16)
    pos_y = POPUP_Y

    lua_dock = f"""
    local target_addr = "{addr}"
    for _, w in ipairs(hl.get_windows()) do
      if w.address == target_addr then
        hl.dispatch(hl.dsp.focus({{ window = w }}))
        local act = hl.get_active_window()
        if act and act.address == target_addr then
          if act.fullscreen and act.fullscreen ~= 0 then
            hl.dispatch(hl.dsp.window.fullscreen({{ mode = "fullscreen" }}))
          end
          if not act.floating then
            hl.dispatch(hl.dsp.window.float({{ action = "toggle" }}))
          end
          hl.dispatch(hl.dsp.window.move({{ workspace = "special:runescape", follow = false }}))
          hl.dispatch(hl.dsp.window.move({{ x = {pos_x}, y = {pos_y}, relative = false }}))
          hl.dispatch(hl.dsp.window.resize({{ x = {POPUP_W}, y = {POPUP_H}, relative = false }}))
        end
        break
      end
    end
    """
    run_hypr_eval(lua_dock)
    active_sw = get_active_special_workspace()
    if active_sw != "special:runescape":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
    state = safe_read_state()
    state["mode"] = "popup"
    state["popupOpen"] = True
    state["openedAt"] = time.time()
    state["hasGainedFocus"] = True
    safe_write_state(state)
    return {"ok": True, "mode": "popup", "popupOpen": True}

def action_toggle_launcher():
    run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape_launcher")')
    return {"ok": True}

def action_quit():
    bin_path = get_pkill()
    if bin_path:
        for target in ["RuneLite", "jagex-launcher"]:
            proc = None
            try:
                proc = subprocess.Popen(
                    [bin_path, "-f", target],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    close_fds=True
                )
                proc.wait(timeout=2.0)
            except Exception:
                if proc:
                    try:
                        proc.kill()
                        proc.wait()
                    except Exception:
                        pass
    state = safe_read_state()
    state["running"] = False
    state["launcherRunning"] = False
    state["popupOpen"] = False
    state["alert"] = False
    safe_write_state(state)
    return {"ok": True}

def launch_binary(target_app, env):
    if not is_trusted_executable(target_app):
        raise PermissionError(f"Untrusted executable path: {target_app}")

    ensure_state_dir()
    log_file = STATE_DIR / "launcher.log"
    log_str = str(log_file)

    if os.path.islink(log_str):
        os.unlink(log_str)

    has_fuse2 = False
    for lib_dir in ["/usr/lib", "/usr/lib64", "/lib", "/lib64"]:
        fuse_path = f"{lib_dir}/libfuse.so.2"
        if os.path.exists(fuse_path):
            has_fuse2 = True
            break

    cmd = [target_app]
    if not has_fuse2 and target_app.lower().endswith(".appimage"):
        cmd.append("--appimage-extract-and-run")

    log_flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    log_fd = os.open(log_str, log_flags, 0o600)

    if os.fstat(log_fd).st_size > 1048576:
        os.ftruncate(log_fd, 0)

    with os.fdopen(log_fd, "a", encoding="utf-8") as out:
        out.write(f"\n--- Launching {target_app} at {time.ctime()} ---\n")
        out.write(f"Command: {' '.join(cmd)}\n")
        out.flush()
        proc = subprocess.Popen(
            cmd,
            env=env,
            start_new_session=True,
            stdout=out,
            stderr=subprocess.STDOUT,
            close_fds=True
        )
        return proc

def action_launch():
    env = os.environ.copy()
    env["GDK_SCALE"] = "1"
    env["_JAVA_OPTIONS"] = "-Dsun.java2d.uiScale=1.0"

    target_app = find_jagex_launcher() or find_runelite()
    if not target_app:
        err = "Neither Jagex Launcher nor RuneLite binary was found in trusted paths."
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}
    try:
        launch_binary(target_app, env)
        state = safe_read_state()
        state["launcherRunning"] = True
        safe_write_state(state)
        return {"ok": True, "launched": target_app}
    except Exception as e:
        err = f"Failed to start {Path(target_app).name}: {e}"
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}

def action_launch_runelite_direct():
    env = os.environ.copy()
    env["GDK_SCALE"] = "1"
    env["_JAVA_OPTIONS"] = "-Dsun.java2d.uiScale=1.0"

    target_app = find_runelite()
    if not target_app:
        err = "RuneLite binary was not found in trusted paths."
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}
    try:
        launch_binary(target_app, env)
        return {"ok": True, "launched": target_app}
    except Exception as e:
        err = f"Failed to start RuneLite: {e}"
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}

def action_clear_alert():
    state = safe_read_state()
    state["alert"] = False
    state["alertMessage"] = ""
    safe_write_state(state)
    return {"ok": True}

def action_set_config(data):
    state = safe_read_state()
    if "showCharacterName" in data:
        val = bool(data["showCharacterName"])
        state["showCharacterName"] = val
        update_shell_json_setting(val)
    safe_write_state(state)
    return {"ok": True, "showCharacterName": state.get("showCharacterName", True)}

def check_notifications(state):
    notif_dirs = [NOTIF_DIR / "history", NOTIF_DIR]
    last_ts = int(state.get("lastNotifTime", 0))
    highest_ts = last_ts
    alert_msg = None
    files_scanned = 0

    for d in notif_dirs:
        d_str = str(d)
        if not os.path.exists(d_str):
            continue
        try:
            d_st = os.lstat(d_str)
            if stat.S_ISLNK(d_st.st_mode) or d_st.st_uid != os.getuid():
                continue
        except Exception:
            continue

        entries = []
        try:
            with os.scandir(d_str) as it:
                for entry in it:
                    if files_scanned >= MAX_NOTIF_FILES_SCANNED:
                        break
                    try:
                        if entry.name.endswith(".json") and entry.is_file(follow_symlinks=False):
                            entries.append(entry.path)
                            files_scanned += 1
                    except Exception:
                        continue
        except Exception:
            continue

        for file_path in entries:
            try:
                st = os.lstat(file_path)
                if stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
                    continue
                if st.st_size > MAX_FILE_BYTES:
                    continue

                fname = os.path.basename(file_path)
                if "-" in fname:
                    ts_part = fname.split("-", 1)[0]
                    if ts_part.isdigit() and int(ts_part) <= last_ts:
                        continue

                flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
                fd = os.open(file_path, flags)
                with os.fdopen(fd, "r", encoding="utf-8") as nf:
                    raw_data = nf.read(MAX_FILE_BYTES)
                data = json.loads(raw_data)
                ts = int(data.get("timestamp", 0))
                if ts <= last_ts:
                    continue

                app = str(data.get("app", "")).lower()
                summary = str(data.get("summary", "")).lower()
                body = str(data.get("body", "")).lower()
                text = f"{app} {summary} {body}"

                if any(k in text for k in ["runelite", "runescape", "mining", "idle", "woodcutting", "fishing", "combat", "afk"]):
                    if ts > highest_ts:
                        highest_ts = ts
                        alert_msg = str(data.get("body") or data.get("summary") or "AFK / Idle Alert")[:128]
            except Exception:
                continue

    if alert_msg:
        return True, alert_msg, highest_ts
    return False, "", highest_ts

def is_safe_socket(path_str):
    try:
        st = os.lstat(path_str)
        if stat.S_ISLNK(st.st_mode):
            return False
        if not stat.S_ISSOCK(st.st_mode):
            return False
        if st.st_uid != os.getuid():
            return False
        return True
    except Exception:
        return False

def run_daemon():
    if not acquire_daemon_lock():
        print("Daemon lock already held by another process; exiting.")
        return

    old_pid = read_daemon_pid()
    if old_pid is not None:
        try:
            os.kill(old_pid, 0)
            print(f"Daemon already running with PID {old_pid}")
            remove_daemon_lock()
            return
        except (ProcessLookupError, ValueError):
            remove_daemon_pid()

    try:
        write_daemon_pid()
    except Exception as e:
        print(f"Failed to acquire daemon PID file: {e}", file=sys.stderr)
        remove_daemon_lock()
        return

    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    sock_path = f"{xdg}/hypr/{sig}/.socket2.sock"

    sock = None
    last_reconnect = 0
    last_poll = 0
    buffer = ""

    init_state = safe_read_state()
    if init_state.get("lastNotifTime", 0) == 0:
        init_state["lastNotifTime"] = int(time.time() * 1000)
        safe_write_state(init_state)

    print(f"RuneScape Daemon started (PID {os.getpid()})")

    try:
        while True:
            now = time.time()

            if not sock and (now - last_reconnect) > 2:
                last_reconnect = now
                try:
                    if is_safe_socket(sock_path):
                        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                        sock.connect(sock_path)
                        sock.setblocking(False)
                except Exception:
                    sock = None

            if now - last_poll > 1.0:
                last_poll = now
                rescue_trapped_windows()
                state = safe_read_state()
                has_alert, notif_msg, highest_id = check_notifications(state)
                client = get_runelite_client()

                modified = False
                if highest_id > state.get("lastNotifTime", 0):
                    state["lastNotifTime"] = highest_id
                    modified = True

                if has_alert and not state.get("alert"):
                    state["alert"] = True
                    state["alertMessage"] = notif_msg
                    modified = True

                in_scratchpad = is_runelite_in_scratchpad(client)
                target_mode = "popup" if in_scratchpad else "normal"
                if state.get("mode") != target_mode:
                    state["mode"] = target_mode
                    modified = True

                if client:
                    ensure_jagex_launcher_hidden()
                    if not state.get("running"):
                        state["running"] = True
                        modified = True
                    char_name = ""
                    title = client.get("title", "")
                    if " - " in title:
                        char_name = title.split(" - ", 1)[1].strip()
                    if char_name and state.get("character") != char_name:
                        state["character"] = char_name
                        modified = True
                else:
                    if state.get("running"):
                        state["running"] = False
                        state["popupOpen"] = False
                        state["hasGainedFocus"] = False
                        modified = True

                if in_scratchpad:
                    active_sw_poll = get_active_special_workspace()
                    is_sw_visible = (active_sw_poll == "special:runescape")
                    now_poll = time.time()
                    opened_at_poll = float(state.get("openedAt", 0))
                    if state.get("popupOpen") and not is_sw_visible and (now_poll - opened_at_poll) >= 1.0:
                        state["popupOpen"] = False
                        state["hasGainedFocus"] = False
                        modified = True
                    elif not state.get("popupOpen") and is_sw_visible and (now_poll - opened_at_poll) >= 1.0:
                        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
                        refocus_active_workspace()
                else:
                    if state.get("popupOpen"):
                        state["popupOpen"] = False
                        state["hasGainedFocus"] = False
                        modified = True

                if modified:
                    safe_write_state(state)

            readable = []
            if sock:
                readable, _, _ = select.select([sock], [], [], 1.0)
            else:
                time.sleep(1.0)

            if sock and readable:
                try:
                    data = sock.recv(4096).decode("utf-8", errors="ignore")
                    if not data:
                        sock.close()
                        sock = None
                        continue
                    buffer += data
                    if len(buffer) > MAX_SOCKET_BUFFER:
                        buffer = buffer[-MAX_SOCKET_BUFFER:]

                    while "\n" in buffer:
                        line, buffer = buffer.split("\n", 1)
                        line = line.strip()
                        if not line:
                            continue

                        if line.startswith("activewindow>>"):
                            payload = line[len("activewindow>>"):]
                            parts = payload.split(",", 1)
                            active_cls = parts[0].strip().lower()
                            state = safe_read_state()
                            now = time.time()
                            is_runelite = ("runelite" in active_cls or active_cls == "net-runelite-launcher-launcher")
                            opened_at = float(state.get("openedAt", 0))

                            if is_runelite:
                                client = get_runelite_client()
                                in_scratchpad = is_runelite_in_scratchpad(client)

                                if in_scratchpad and not state.get("popupOpen") and (now - opened_at) >= 1.0:
                                    active_sw = get_active_special_workspace()
                                    if active_sw == "special:runescape":
                                        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
                                    refocus_active_workspace()
                                else:
                                    modified = False
                                    if state.get("alert"):
                                        state["alert"] = False
                                        state["alertMessage"] = ""
                                        modified = True
                                    if in_scratchpad and not state.get("hasGainedFocus"):
                                        state["hasGainedFocus"] = True
                                        modified = True
                                    if modified:
                                        safe_write_state(state)

                            if state.get("popupOpen") and state.get("hasGainedFocus") and not is_runelite and active_cls != "" and (now - opened_at) >= 1.0:
                                client = get_runelite_client()
                                if is_runelite_in_scratchpad(client):
                                    active_sw = get_active_special_workspace()
                                    if active_sw == "special:runescape":
                                        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
                                    refocus_active_workspace()
                                state["popupOpen"] = False
                                state["hasGainedFocus"] = False
                                state["lastDismissTime"] = now
                                state["lastUpdated"] = int(now * 1000)
                                safe_write_state(state)

                        elif line.startswith("workspace>>"):
                            state = safe_read_state()
                            now = time.time()
                            opened_at = float(state.get("openedAt", 0))
                            if state.get("popupOpen") and (now - opened_at) >= 0.8:
                                client = get_runelite_client()
                                if is_runelite_in_scratchpad(client):
                                    active_sw = get_active_special_workspace()
                                    if active_sw == "special:runescape":
                                        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
                                    refocus_active_workspace()
                                state["popupOpen"] = False
                                state["lastDismissTime"] = now
                                state["lastUpdated"] = int(now * 1000)
                                safe_write_state(state)

                        elif line.startswith("openwindow>>"):
                            payload = line[len("openwindow>>"):]
                            parts = payload.split(",", 3)
                            if len(parts) >= 3:
                                opened_cls = parts[2].strip().lower()
                                if "runelite" in opened_cls:
                                    ensure_jagex_launcher_hidden()
                                    ensure_runelite_geometry()

                        elif line.startswith("urgent>>"):
                            addr = line[len("urgent>>"):].strip().lower().replace("0x", "")
                            state = safe_read_state()
                            client = get_runelite_client()
                            if client:
                                c_addr = (client.get("address") or "").lower().replace("0x", "")
                                if c_addr == addr:
                                    state["alert"] = True
                                    state["alertMessage"] = "AFK / Idle Alert"
                                    safe_write_state(state)

                        elif line.startswith("closewindow>>"):
                            addr = line[len("closewindow>>"):].strip()
                            state = safe_read_state()
                            if state.get("address") == addr:
                                state["running"] = False
                                state["popupOpen"] = False
                                safe_write_state(state)
                except Exception:
                    if sock:
                        sock.close()
                    sock = None

    finally:
        remove_daemon_pid()
        remove_daemon_lock()

def ensure_daemon_running():
    old_pid = read_daemon_pid()
    if old_pid is not None:
        try:
            os.kill(old_pid, 0)
            return
        except ProcessLookupError:
            remove_daemon_pid()

    script_path = os.path.abspath(__file__)
    if not is_trusted_executable(script_path):
        return
    py_bin = PYTHON_BIN if is_trusted_executable(PYTHON_BIN) else sys.executable
    if not is_trusted_executable(py_bin):
        return

    subprocess.Popen(
        [py_bin, script_path, "daemon"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        close_fds=True
    )

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "daemon":
        run_daemon()
        return

    req = {}
    if len(sys.argv) > 1 and sys.argv[1] != "daemon":
        req = {"action": sys.argv[1]}
    elif not sys.stdin.isatty():
        raw_line = sys.stdin.readline(MAX_STDIN_BYTES)
        if raw_line and raw_line.strip():
            try:
                req = json.loads(raw_line)
            except Exception as e:
                print(json.dumps({"ok": False, "error": f"Invalid JSON: {e}"}))
                sys.exit(1)

    action = req.get("action", "status")

    if action == "status":
        res = action_status()
    elif action == "toggle":
        res = action_toggle()
    elif action == "dismiss":
        res = action_dismiss()
    elif action == "detach":
        res = action_detach(req.get("workspace", "5"))
    elif action == "dock":
        res = action_dock()
    elif action == "launch":
        res = action_launch()
    elif action == "launch_runelite":
        res = action_launch_runelite_direct()
    elif action == "toggle_launcher":
        res = action_toggle_launcher()
    elif action == "quit":
        res = action_quit()
    elif action == "clear_alert":
        res = action_clear_alert()
    elif action == "set_config":
        res = action_set_config(req)
    else:
        res = {"ok": False, "error": f"Unknown action: {action}"}

    print(json.dumps(res))

if __name__ == "__main__":
    main()
