#!/usr/bin/env python3
"""
RuneScape Quick-Screen & Notification Manager Helper
Manages RuneLite Hyprland scratchpad overlay, Jagex Launcher processes,
focus-loss auto-dismiss, and idle/AFK notification flasher.
"""

import os
import sys
import json
import time
import socket
import select
import shutil
import subprocess
from pathlib import Path

MAX_STDIN_BYTES = 65536
STATE_DIR = Path.home() / ".local/state/omarchy/cjkaufman.runescape"
STATE_FILE = STATE_DIR / "state.json"
PID_FILE = Path(f"/run/user/{os.getuid()}/runescape-helper.pid")
NOTIF_DIR = Path.home() / ".local/state/omarchy/notifications"

def send_desktop_notification(summary, body, urgency="normal"):
    try:
        subprocess.run(["notify-send", "-u", urgency, "-a", "RuneScape", summary, body], timeout=2)
    except Exception:
        pass

def ensure_executable(path):
    if not path:
        return path
    try:
        p = Path(path)
        if p.exists() and p.is_file():
            if not os.access(str(p), os.X_OK):
                current_mode = p.stat().st_mode
                p.chmod(current_mode | 0o755)
    except Exception as e:
        print(f"Could not chmod +x {path}: {e}", file=sys.stderr)
    return str(path)

def check_for_windows_installer():
    search_roots = [Path.home() / "Downloads", Path.home() / "Desktop"]
    for root_dir in search_roots:
        if not root_dir.exists():
            continue
        try:
            for f in root_dir.rglob("*"):
                if f.is_file() and "jagex" in f.name.lower() and f.name.lower().endswith(".exe"):
                    return str(f)
        except Exception:
            pass
    return None

def find_jagex_launcher():
    # 1. Standard candidate locations
    candidates = [
        shutil.which("jagex-launcher"),
        shutil.which("jagexlauncher"),
        Path.home() / ".local/bin/jagex-launcher",
        Path.home() / ".local/share/Jagex Launcher/jagex-launcher",
    ]
    for c in candidates:
        if c and Path(c).exists() and Path(c).is_file():
            return ensure_executable(str(c))

    # 2. Search common user directories (case-insensitive)
    search_roots = [
        Path.home() / "Downloads",
        Path.home() / "Desktop",
        Path.home() / "Applications",
        Path.home() / "Games",
        Path.home() / ".local/share/Jagex Launcher",
    ]

    found_appimages = []
    found_executables = []

    for root_dir in search_roots:
        if not root_dir.exists():
            continue
        try:
            for f in root_dir.rglob("*"):
                if not f.is_file():
                    continue
                name_lower = f.name.lower()
                if "jagex" in name_lower:
                    if name_lower.endswith(".appimage"):
                        found_appimages.append((f.stat().st_mtime, f))
                    elif not name_lower.endswith((".exe", ".txt", ".png", ".jpg", ".zip", ".tar.gz", ".deb", ".rpm")):
                        if os.access(str(f), os.X_OK):
                            found_executables.append((f.stat().st_mtime, f))
        except Exception:
            pass

    if found_appimages:
        found_appimages.sort(key=lambda x: x[0], reverse=True)
        return ensure_executable(str(found_appimages[0][1]))

    if found_executables:
        found_executables.sort(key=lambda x: x[0], reverse=True)
        return ensure_executable(str(found_executables[0][1]))

    return None

def find_runelite():
    candidates = [
        shutil.which("runelite"),
        shutil.which("RuneLite"),
        Path.home() / ".local/share/Jagex Launcher/games/runelite/RuneLite.AppImage",
        Path.home() / ".local/share/runelite/RuneLite.AppImage",
        Path.home() / ".local/bin/RuneLite.AppImage",
        Path("/var/lib/flatpak/exports/bin/net.runelite.RuneLite"),
        Path.home() / ".local/share/flatpak/exports/bin/net.runelite.RuneLite",
    ]
    for c in candidates:
        if c and Path(c).exists() and Path(c).is_file():
            return ensure_executable(str(c))

    search_roots = [
        Path.home() / "Downloads",
        Path.home() / "Desktop",
        Path.home() / "Applications",
        Path.home() / "Games",
        Path.home() / ".local/share",
    ]
    for root_dir in search_roots:
        if not root_dir.exists():
            continue
        try:
            for f in root_dir.rglob("*"):
                if not f.is_file():
                    continue
                name_lower = f.name.lower()
                if "runelite" in name_lower and name_lower.endswith(".appimage"):
                    return ensure_executable(str(f))
        except Exception:
            pass
    return None

POPUP_W = 840
POPUP_H = 600
POPUP_X = 680
POPUP_Y = 34

def ensure_state_dir():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)

def safe_write_state(state):
    ensure_state_dir()
    payload = json.dumps(state, indent=2).encode("utf-8")
    tmp_file = STATE_DIR / f".state.tmp.{os.getpid()}"
    try:
        fd = os.open(str(tmp_file), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        os.replace(str(tmp_file), str(STATE_FILE))
    except Exception as e:
        if tmp_file.exists():
            tmp_file.unlink(missing_ok=True)
        print(f"Failed to write state: {e}", file=sys.stderr)

def read_shell_json_setting():
    shell_json = Path.home() / ".config/omarchy/shell.json"
    if shell_json.exists():
        try:
            with open(shell_json, "r", encoding="utf-8") as f:
                data = json.load(f)
            sections = data.get("bar", {}).get("layout", {})
            for sec in ["left", "center", "right"]:
                for item in sections.get(sec, []):
                    if isinstance(item, dict) and item.get("id") == "cjkaufman.runescape":
                        if "showCharacterName" in item:
                            return bool(item["showCharacterName"])
        except Exception:
            pass
    return True

def update_shell_json_setting(show_character_name):
    shell_json = Path.home() / ".config/omarchy/shell.json"
    if not shell_json.exists():
        return
    try:
        with open(shell_json, "r", encoding="utf-8") as f:
            data = json.load(f)
        modified = False
        sections = data.get("bar", {}).get("layout", {})
        for sec in ["left", "center", "right"]:
            items = sections.get(sec, [])
            for item in items:
                if isinstance(item, dict) and item.get("id") == "cjkaufman.runescape":
                    if item.get("showCharacterName") != show_character_name:
                        item["showCharacterName"] = show_character_name
                        modified = True
        if modified:
            tmp = shell_json.with_suffix(".tmp")
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
            os.replace(tmp, shell_json)
    except Exception as e:
        print(f"Error updating shell.json: {e}", file=sys.stderr)

def safe_read_state():
    default_show_name = read_shell_json_setting()
    if not STATE_FILE.exists():
        return {
            "running": False,
            "launcherRunning": False,
            "character": "",
            "popupOpen": False,
            "mode": "popup",
            "alert": False,
            "alertMessage": "",
            "address": "",
            "showCharacterName": default_show_name,
            "lastDismissTime": 0,
            "lastNotifId": 0,
            "lastUpdated": int(time.time() * 1000)
        }
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            st = json.load(f)
            if "showCharacterName" not in st:
                st["showCharacterName"] = default_show_name
            return st
    except Exception:
        return {}

def run_hyprctl(args):
    try:
        res = subprocess.run(["hyprctl"] + args, capture_output=True, text=True, timeout=3)
        return res.stdout.strip()
    except Exception as e:
        print(f"hyprctl error: {e}", file=sys.stderr)
        return ""

def run_hypr_eval(lua_code):
    try:
        res = subprocess.run(["hyprctl", "eval", lua_code], capture_output=True, text=True, timeout=3)
        return res.stdout.strip()
    except Exception as e:
        print(f"hyprctl eval error: {e}", file=sys.stderr)
        return ""

def run_hypr_dispatch(lua_dsp):
    try:
        res = subprocess.run(["hyprctl", "dispatch", lua_dsp], capture_output=True, text=True, timeout=3)
        return res.stdout.strip()
    except Exception as e:
        print(f"hyprctl dispatch error: {e}", file=sys.stderr)
        return ""

def get_runelite_client():
    out = run_hyprctl(["clients", "-j"])
    if not out:
        return None
    try:
        clients = json.loads(out)
        for c in clients:
            cls = c.get("class", "").lower()
            if "runelite" in cls or cls == "net-runelite-launcher-launcher":
                return c
    except Exception:
        pass
    return None

def is_jagex_launcher_running():
    try:
        res = subprocess.run(["pgrep", "-f", "jagex-launcher"], capture_output=True, text=True)
        return res.returncode == 0
    except Exception:
        return False

def get_active_special_workspace():
    try:
        out = run_hyprctl(["monitors", "-j"])
        if not out:
            return ""
        mons = json.loads(out)
        for m in mons:
            if m.get("focused"):
                return m.get("specialWorkspace", {}).get("name", "")
        if mons:
            return mons[0].get("specialWorkspace", {}).get("name", "")
    except Exception:
        pass
    return ""

def get_monitor_geometry():
    try:
        out = run_hyprctl(["monitors", "-j"])
        if out:
            mons = json.loads(out)
            for m in mons:
                if m.get("focused"):
                    scale = float(m.get("scale", 1.0))
                    w = int(m.get("width", 1920) / scale)
                    h = int(m.get("height", 1080) / scale)
                    return w, h
            if mons:
                m = mons[0]
                scale = float(m.get("scale", 1.0))
                w = int(m.get("width", 1920) / scale)
                h = int(m.get("height", 1080) / scale)
                return w, h
    except Exception:
        pass
    return 1280, 720

def rescue_trapped_windows():
    """
    Safety invariant: scans special:runescape. If any non-RuneLite window
    (such as zen browser or foot) is on special:runescape, moves it back
    to workspace 1 immediately.
    """
    lua = """
    for _, w in ipairs(hl.get_windows()) do
      if w.workspace and w.workspace.name == "special:runescape" then
        local cls = (w.class or ""):lower()
        if not (cls:find("runelite") or cls:find("net-runelite")) then
          hl.dispatch(hl.dsp.focus({ window = w }))
          local act = hl.get_active_window()
          if act and act.address == w.address then
            hl.dispatch(hl.dsp.window.move({ workspace = "1", follow = false }))
          end
        end
      end
    end
    """
    run_hypr_eval(lua)

def refocus_active_workspace():
    """
    Shifts focus to any window on the currently active normal workspace.
    Guarantees RuneLite is never left as the top-of-stack focused window
    when the special:runescape workspace is hidden or dismissed.
    """
    lua = """
    local active_ws = hl.get_active_workspace()
    if not active_ws then return end
    for _, w in ipairs(hl.get_windows()) do
      if w.workspace and w.workspace.id == active_ws.id then
        hl.dispatch(hl.dsp.focus({ window = w }))
        return
      end
    end
    """
    run_hypr_eval(lua)

def ensure_runelite_geometry(w=POPUP_W, h=POPUP_H):
    """
    Positions and resizes RuneLite directly under the top bar.
    STRICT SAFETY: Only moves the window if focus was verified to match
    the RuneLite address. Never touches any other application window.
    """
    client = get_runelite_client()
    if not client:
        return
    addr = client.get("address", "")
    if not addr:
        return

    mon_w, _ = get_monitor_geometry()
    pos_x = max(0, mon_w - w - 16)
    pos_y = POPUP_Y

    lua = f"""
    local target_addr = "{addr}"
    for _, win in ipairs(hl.get_windows()) do
      if win.address == target_addr then
        hl.dispatch(hl.dsp.focus({{ window = win }}))
        local act = hl.get_active_window()
        if act and act.address == target_addr then
          hl.dispatch(hl.dsp.window.move({{ x = {pos_x}, y = {pos_y}, relative = false }}))
          hl.dispatch(hl.dsp.window.resize({{ x = {w}, y = {h}, relative = false }}))
        end
        break
      end
    end
    """
    run_hypr_eval(lua)

def ensure_jagex_launcher_hidden():
    """
    If RuneLite is running, ensure jagex-launcher scratchpad
    is closed/tucked away in 'special:runescape_launcher'.
    """
    active_sw = get_active_special_workspace()
    if active_sw == "special:runescape_launcher":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape_launcher")')

def action_status():
    ensure_daemon_running()
    rescue_trapped_windows()
    client = get_runelite_client()
    state = safe_read_state()
    jagex_running = is_jagex_launcher_running()

    if client:
        ensure_jagex_launcher_hidden()
        title = client.get("title", "")
        char_name = ""
        if " - " in title:
            char_name = title.split(" - ", 1)[1].strip()
        state["running"] = True
        state["character"] = char_name or state.get("character", "DarkOmenZA")
        state["address"] = client.get("address", "")
        ws = client.get("workspace", {}).get("name", "")
        if "special:runescape" in ws:
            state["mode"] = "popup"
        else:
            state["mode"] = "normal"
    else:
        state["running"] = False
        state["popupOpen"] = False

    state["launcherRunning"] = jagex_running
    state["lastUpdated"] = int(time.time() * 1000)
    safe_write_state(state)
    return state

def action_toggle():
    rescue_trapped_windows()
    client = get_runelite_client()
    state = safe_read_state()
    if not client:
        return {"ok": False, "error": "RuneLite is not running", "running": False}

    active_sw = get_active_special_workspace()
    is_open = (active_sw == "special:runescape")
    now = time.time()
    last_dismiss = float(state.get("lastDismissTime", 0))

    if not is_open and (now - last_dismiss) < 0.4:
        state["popupOpen"] = False
        state["lastUpdated"] = int(now * 1000)
        safe_write_state(state)
        return {"ok": True, "popupOpen": False}

    if active_sw == "special:runescape_launcher":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape_launcher")')

    target_open = not is_open
    state["popupOpen"] = target_open
    state["running"] = True
    state["lastUpdated"] = int(now * 1000)

    if target_open:
        state["alert"] = False
        state["alertMessage"] = ""
        state["openedAt"] = now
        state["hasGainedFocus"] = False
        safe_write_state(state)
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
        ensure_runelite_geometry()
        # Explicitly focus RuneLite so player is ready immediately
        addr = client.get("address", "")
        if addr:
            run_hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "address:{addr}" }}))')
    else:
        state["lastDismissTime"] = now
        safe_write_state(state)
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
        refocus_active_workspace()

    return {"ok": True, "popupOpen": state["popupOpen"]}

def action_dismiss():
    state = safe_read_state()
    active_sw = get_active_special_workspace()
    now = time.time()
    state["popupOpen"] = False
    state["hasGainedFocus"] = False
    state["lastDismissTime"] = now
    state["lastUpdated"] = int(now * 1000)
    safe_write_state(state)
    if active_sw == "special:runescape":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
    refocus_active_workspace()
    return {"ok": True, "popupOpen": False}

def action_detach(ws="5"):
    client = get_runelite_client()
    if not client:
        return {"ok": False, "error": "RuneLite is not running"}
    addr = client.get("address", "")
    if not addr:
        return {"ok": False, "error": "No RuneLite address"}

    lua_detach = f"""
    local target_addr = "{addr}"
    for _, w in ipairs(hl.get_windows()) do
      if w.address == target_addr then
        hl.dispatch(hl.dsp.focus({{ window = w }}))
        local act = hl.get_active_window()
        if act and act.address == target_addr then
          hl.dispatch(hl.dsp.window.move({{ workspace = "{ws}", follow = true }}))
          hl.dispatch(hl.dsp.window.center({{}}))
        end
        break
      end
    end
    """
    run_hypr_eval(lua_detach)
    active_sw = get_active_special_workspace()
    if active_sw == "special:runescape":
        run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
    state = safe_read_state()
    state["popupOpen"] = False
    state["mode"] = "normal"
    safe_write_state(state)
    return {"ok": True, "mode": "normal", "workspace": ws}

def action_dock():
    client = get_runelite_client()
    if not client:
        return {"ok": False, "error": "RuneLite is not running"}
    addr = client.get("address", "")
    if not addr:
        return {"ok": False, "error": "No RuneLite address"}

    mon_w, _ = get_monitor_geometry()
    pos_x = max(0, mon_w - POPUP_W - 16)
    pos_y = POPUP_Y

    lua_dock = f"""
    local target_addr = "{addr}"
    for _, w in ipairs(hl.get_windows()) do
      if w.address == target_addr then
        hl.dispatch(hl.dsp.focus({{ window = w }}))
        local act = hl.get_active_window()
        if act and act.address == target_addr then
          hl.dispatch(hl.dsp.window.move({{ workspace = "special:runescape", follow = false }}))
          hl.dispatch(hl.dsp.window.move({{ x = {pos_x}, y = {pos_y}, relative = false }}))
          hl.dispatch(hl.dsp.window.resize({{ x = {POPUP_W}, y = {POPUP_H}, relative = false }}))
        end
        break
      end
    end
    """
    run_hypr_eval(lua_dock)
    state = safe_read_state()
    state["mode"] = "popup"
    safe_write_state(state)
    return {"ok": True, "mode": "popup"}

def action_toggle_launcher():
    """
    Toggles visibility of Jagex Launcher (in special:runescape_launcher).
    """
    run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape_launcher")')
    return {"ok": True}

def action_quit():
    """
    Terminates both RuneLite and Jagex Launcher cleanly when requested.
    """
    try:
        subprocess.run(["pkill", "-f", "RuneLite"], capture_output=True)
        subprocess.run(["pkill", "-f", "jagex-launcher"], capture_output=True)
    except Exception:
        pass
    state = safe_read_state()
    state["running"] = False
    state["launcherRunning"] = False
    state["popupOpen"] = False
    state["alert"] = False
    safe_write_state(state)
    return {"ok": True}

def launch_binary(target_app, env):
    ensure_state_dir()
    log_file = STATE_DIR / "launcher.log"
    ensure_executable(target_app)

    has_fuse2 = False
    for lib_dir in ["/usr/lib", "/usr/lib64", "/lib", "/lib64"]:
        if Path(f"{lib_dir}/libfuse.so.2").exists():
            has_fuse2 = True
            break

    cmd = [target_app]
    if not has_fuse2 and target_app.lower().endswith(".appimage"):
        cmd.append("--appimage-extract-and-run")

    with open(log_file, "a", encoding="utf-8") as out:
        out.write(f"\n--- Launching {target_app} at {time.ctime()} ---\n")
        out.write(f"Command: {' '.join(cmd)}\n")
        out.flush()
        proc = subprocess.Popen(
            cmd,
            env=env,
            start_new_session=True,
            stdout=out,
            stderr=subprocess.STDOUT
        )
        return proc

def action_launch():
    env = os.environ.copy()
    env["GDK_SCALE"] = "1"
    env["_JAVA_OPTIONS"] = "-Dsun.java2d.uiScale=1.0"

    target_app = find_jagex_launcher() or find_runelite()
    if not target_app:
        win_installer = check_for_windows_installer()
        if win_installer:
            err = f"Found Windows installer ({Path(win_installer).name}) in Downloads, but Linux requires the Linux AppImage from Jagex."
        else:
            err = "Neither Jagex Launcher nor RuneLite AppImage was found in ~/Downloads or PATH."
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}
    try:
        launch_binary(target_app, env)
        state = safe_read_state()
        state["launcherRunning"] = True
        safe_write_state(state)
        return {"ok": True, "launched": target_app}
    except Exception as e:
        err = f"Failed to start {Path(target_app).name}: {e}"
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}

def action_launch_runelite_direct():
    env = os.environ.copy()
    env["GDK_SCALE"] = "1"
    env["_JAVA_OPTIONS"] = "-Dsun.java2d.uiScale=1.0"

    target_app = find_runelite()
    if not target_app:
        err = "RuneLite AppImage or binary was not found in ~/Downloads or PATH."
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}
    try:
        launch_binary(target_app, env)
        return {"ok": True, "launched": target_app}
    except Exception as e:
        err = f"Failed to start RuneLite: {e}"
        send_desktop_notification("RuneScape Launch Error", err, urgency="critical")
        return {"ok": False, "error": err}

def action_clear_alert():
    state = safe_read_state()
    state["alert"] = False
    state["alertMessage"] = ""
    safe_write_state(state)
    return {"ok": True}

def action_set_config(data):
    state = safe_read_state()
    if "showCharacterName" in data:
        val = bool(data["showCharacterName"])
        state["showCharacterName"] = val
        update_shell_json_setting(val)
    safe_write_state(state)
    return {"ok": True, "showCharacterName": state.get("showCharacterName", True)}

def check_notifications(state):
    notif_dirs = [NOTIF_DIR / "history", NOTIF_DIR]
    last_ts = int(state.get("lastNotifTime", 0))
    highest_ts = last_ts
    alert_msg = None

    for d in notif_dirs:
        if not d.exists():
            continue
        for f in d.glob("*.json"):
            try:
                fname = f.name
                if "-" in fname and fname.endswith(".json"):
                    ts_part = fname.split("-", 1)[0]
                    if ts_part.isdigit() and int(ts_part) <= last_ts:
                        continue

                with open(f, "r", encoding="utf-8") as nf:
                    data = json.load(nf)
                ts = int(data.get("timestamp", 0))
                if ts <= last_ts:
                    continue

                app = str(data.get("app", "")).lower()
                summary = str(data.get("summary", "")).lower()
                body = str(data.get("body", "")).lower()
                text = f"{app} {summary} {body}"

                if "runelite" in app or "runescape" in app or "mining" in text or "idle" in text or "woodcutting" in text or "fishing" in text or "combat" in text or "afk" in text:
                    if ts > highest_ts:
                        highest_ts = ts
                        alert_msg = data.get("body") or data.get("summary") or "AFK / Idle Alert"
            except Exception:
                continue

    if alert_msg:
        return True, alert_msg, highest_ts
    return False, "", highest_ts

def run_daemon():
    # Enforce singleton
    if PID_FILE.exists():
        try:
            old_pid = int(PID_FILE.read_text().strip())
            os.kill(old_pid, 0)
            print(f"Daemon already running with PID {old_pid}")
            return
        except (ProcessLookupError, ValueError):
            PID_FILE.unlink(missing_ok=True)

    PID_FILE.write_text(str(os.getpid()))

    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    sock_path = f"{xdg}/hypr/{sig}/.socket2.sock"

    sock = None
    last_reconnect = 0
    last_poll = 0
    buffer = ""

    # Initialize notification baseline so we don't alert on old history
    init_state = safe_read_state()
    if init_state.get("lastNotifTime", 0) == 0:
        init_state["lastNotifTime"] = int(time.time() * 1000)
        safe_write_state(init_state)

    print(f"RuneScape Daemon started (PID {os.getpid()})")

    try:
        while True:
            now = time.time()

            # Connect socket2 if needed
            if not sock and (now - last_reconnect) > 2:
                last_reconnect = now
                try:
                    if Path(sock_path).exists():
                        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                        sock.connect(sock_path)
                        sock.setblocking(False)
                except Exception:
                    sock = None

            # Periodic state sync & notification check (every 1 second)
            if now - last_poll > 1.0:
                last_poll = now
                rescue_trapped_windows()
                state = safe_read_state()
                has_alert, notif_msg, highest_id = check_notifications(state)
                client = get_runelite_client()

                modified = False
                if highest_id > state.get("lastNotifTime", 0):
                    state["lastNotifTime"] = highest_id
                    modified = True

                if has_alert and not state.get("alert"):
                    state["alert"] = True
                    state["alertMessage"] = notif_msg
                    modified = True

                if client:
                    ensure_jagex_launcher_hidden()
                    if not state.get("running"):
                        state["running"] = True
                        modified = True
                    char_name = ""
                    title = client.get("title", "")
                    if " - " in title:
                        char_name = title.split(" - ", 1)[1].strip()
                    if char_name and state.get("character") != char_name:
                        state["character"] = char_name
                        modified = True
                else:
                    if state.get("running"):
                        state["running"] = False
                        state["popupOpen"] = False
                        state["hasGainedFocus"] = False
                        modified = True

                # Keep popupOpen in sync with special:runescape visibility
                active_sw_poll = get_active_special_workspace()
                is_sw_visible = (active_sw_poll == "special:runescape")
                now_poll = time.time()
                opened_at_poll = float(state.get("openedAt", 0))
                if state.get("popupOpen") and not is_sw_visible and (now_poll - opened_at_poll) >= 1.0:
                    state["popupOpen"] = False
                    state["hasGainedFocus"] = False
                    modified = True
                elif not state.get("popupOpen") and is_sw_visible:
                    state["popupOpen"] = True
                    modified = True

                if modified:
                    safe_write_state(state)

            # Read socket events
            readable = []
            if sock:
                readable, _, _ = select.select([sock], [], [], 1.0)
            else:
                time.sleep(1.0)

            if sock and readable:
                try:
                    data = sock.recv(4096).decode("utf-8", errors="ignore")
                    if not data:
                        sock.close()
                        sock = None
                        continue
                    buffer += data
                    while "\n" in buffer:
                        line, buffer = buffer.split("\n", 1)
                        line = line.strip()
                        if not line:
                            continue

                        # Handle activewindow: auto-hide popup when clicking outside, or clear alert if RuneLite focused
                        if line.startswith("activewindow>>"):
                            payload = line[len("activewindow>>"):]
                            parts = payload.split(",", 1)
                            active_cls = parts[0].strip().lower()
                            state = safe_read_state()
                            now = time.time()
                            is_runelite = ("runelite" in active_cls or active_cls == "net-runelite-launcher-launcher")

                            # User focused or clicked inside RuneLite: clear alert and mark hasGainedFocus
                            if is_runelite:
                                modified = False
                                if state.get("alert"):
                                    state["alert"] = False
                                    state["alertMessage"] = ""
                                    modified = True
                                if not state.get("hasGainedFocus"):
                                    state["hasGainedFocus"] = True
                                    modified = True
                                if modified:
                                    safe_write_state(state)

                            opened_at = float(state.get("openedAt", 0))

                            # Focus lost auto-dismiss:
                            # CRITICAL SAFETY: Only auto-dismiss if:
                            # 1) popup is currently marked open
                            # 2) user previously actually focused/interacted with RuneLite (hasGainedFocus == True)
                            # 3) active_cls is a real application window (not blank or desktop)
                            # 4) grace period of 1.0s has elapsed
                            if state.get("popupOpen") and state.get("hasGainedFocus") and not is_runelite and active_cls != "" and (now - opened_at) >= 1.0:
                                active_sw = get_active_special_workspace()
                                if active_sw == "special:runescape":
                                    run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
                                refocus_active_workspace()
                                state["popupOpen"] = False
                                state["hasGainedFocus"] = False
                                state["lastDismissTime"] = now
                                state["lastUpdated"] = int(now * 1000)
                                safe_write_state(state)

                        # Handle workspace change: dismiss popup if switching workspace
                        elif line.startswith("workspace>>"):
                            state = safe_read_state()
                            now = time.time()
                            opened_at = float(state.get("openedAt", 0))
                            if state.get("popupOpen") and (now - opened_at) >= 0.8:
                                active_sw = get_active_special_workspace()
                                if active_sw == "special:runescape":
                                    run_hypr_dispatch('hl.dsp.workspace.toggle_special("runescape")')
                                refocus_active_workspace()
                                state["popupOpen"] = False
                                state["lastDismissTime"] = now
                                state["lastUpdated"] = int(now * 1000)
                                safe_write_state(state)

                        # Handle openwindow: when RuneLite opens, position it and hide Jagex Launcher
                        elif line.startswith("openwindow>>"):
                            payload = line[len("openwindow>>"):]
                            parts = payload.split(",", 3)
                            if len(parts) >= 3:
                                opened_cls = parts[2].strip().lower()
                                if "runelite" in opened_cls:
                                    ensure_jagex_launcher_hidden()
                                    ensure_runelite_geometry()

                        # Handle urgency hint: flash icon
                        elif line.startswith("urgent>>"):
                            addr = line[len("urgent>>"):].strip().lower().replace("0x", "")
                            state = safe_read_state()
                            client = get_runelite_client()
                            if client:
                                c_addr = (client.get("address") or "").lower().replace("0x", "")
                                if c_addr == addr:
                                    state["alert"] = True
                                    state["alertMessage"] = "AFK / Idle Alert"
                                    safe_write_state(state)

                        # Handle client close
                        elif line.startswith("closewindow>>"):
                            addr = line[len("closewindow>>"):].strip()
                            state = safe_read_state()
                            if state.get("address") == addr:
                                state["running"] = False
                                state["popupOpen"] = False
                                safe_write_state(state)
                except Exception as e:
                    if sock:
                        sock.close()
                    sock = None

    finally:
        PID_FILE.unlink(missing_ok=True)

def ensure_daemon_running():
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, 0)
            return
        except (ProcessLookupError, ValueError):
            PID_FILE.unlink(missing_ok=True)

    # Spawn daemon
    script_path = os.path.abspath(__file__)
    subprocess.Popen([sys.executable, script_path, "daemon"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "daemon":
        run_daemon()
        return

    req = {}
    if len(sys.argv) > 1 and sys.argv[1] != "daemon":
        req = {"action": sys.argv[1]}
    elif not sys.stdin.isatty():
        raw_line = sys.stdin.readline(MAX_STDIN_BYTES)
        if raw_line and raw_line.strip():
            try:
                req = json.loads(raw_line)
            except Exception as e:
                print(json.dumps({"ok": False, "error": f"Invalid JSON: {e}"}))
                sys.exit(1)

    action = req.get("action", "status")

    if action == "status":
        res = action_status()
    elif action == "toggle":
        res = action_toggle()
    elif action == "dismiss":
        res = action_dismiss()
    elif action == "detach":
        res = action_detach(req.get("workspace", "5"))
    elif action == "dock":
        res = action_dock()
    elif action == "launch":
        res = action_launch()
    elif action == "launch_runelite":
        res = action_launch_runelite_direct()
    elif action == "toggle_launcher":
        res = action_toggle_launcher()
    elif action == "quit":
        res = action_quit()
    elif action == "clear_alert":
        res = action_clear_alert()
    elif action == "set_config":
        res = action_set_config(req)
    else:
        res = {"ok": False, "error": f"Unknown action: {action}"}

    print(json.dumps(res))

if __name__ == "__main__":
    main()
